{
  "theme": "dark",
  "library_path": "C:/Users/<you>/Music",
  "download_path": "C:/Users/<you>/Downloads/Music",
  "folder_template": "{album_artist}\\{album}\\{track_number} - {title}.{format}",
  "default_format": "mp3",
  "default_quality": "balanced",
  "max_concurrent_downloads": 3,
  "max_retries": 3,
  "match_threshold": 70,
  "watch_enabled": true,
  "watched_check_interval": 3600,
  "watch_backfill_days": 30,
  "fetch_method": "musicbrainz",
  "fetch_confidence": 0.7,
  "fetch_overwrite": false,
  "fetch_batch_limit": 25,
  "musicbrainz_email": "",
  "acoustid_api_key": "",
  "discogs_token": "",
  "spotify_client_id": "",
  "spotify_client_secret": "",
  "tag_case_mode": "off",
  "backup_before_write": true,
  "backup_format": "json",
  "sync_enabled": true,
  "sync_interval": 21600,
  "sync_max_tracks": 200,
  "spotify_redirect_uri": "http://127.0.0.1:5555/api/connections/callback",
  "spotify_user_token": "",
  "soundcloud_client_id": "",
  "soundcloud_client_secret": "",
  "soundcloud_redirect_uri": "http://127.0.0.1:5555/api/connections/callback",
  "soundcloud_user_token": "",
  "source_priority": [
    "youtube",
    "deezer",
    "soundcloud"
  ],
  "source_fallback": true,
  "auto_update": "notify",
  "duplicate_policy": "keep_separate",
  "server_port": 5555,
  "server_host": "127.0.0.1",
  "auto_shutdown": true,
  "shutdown_timeout": 30
}